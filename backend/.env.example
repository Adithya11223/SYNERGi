# Database Configuration
DB_URL=jdbc:postgresql://db:5432/startuphub
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password
DB_MAX_POOL_SIZE=50

# Redis Configuration (Optional, usually for session/caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Clerk Authentication (Get these from your Clerk dashboard)
CLERK_ISSUER_URI=https://your-clerk-issuer.accounts.dev
CLERK_JWK_SET_URI=https://your-clerk-issuer.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Security & JWT
# Generate a strong 256-bit secret key for JWT signing
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# OTP Settings
OTP_EXPIRY=10
OTP_MAX_ATTEMPTS=3
OTP_RETENTION_DAYS=1

# Server Settings
PORT=8080

# OpenAI API Key (For AI features)
OPENAI_API_KEY=sk-your_openai_api_key

# Storage Signature Secret (For signed URLs)
STORAGE_SIGNATURE_SECRET=your_storage_signature_secret
